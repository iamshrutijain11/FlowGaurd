# --- FlowGuard backend (copy to .env, never commit real secrets) ---
# SQLite for zero-setup local dev:
# DATABASE_URL=sqlite:///./flowguard.db
# PostgreSQL for Docker/production:
DATABASE_URL=postgresql+psycopg2://flowguard:flowguard@localhost:5432/flowguard
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Dev convenience only: create tables without Alembic (use migrations in Docker/prod)
AUTO_CREATE_TABLES=false
# Seeds demo@flowguard.app + CMP-2026-DEMO-001 on startup (idempotent)
SEED_DEMO_DATA=true
LLM_API_KEY=
